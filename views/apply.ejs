<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hikari | Hire The Best People By EAJ Core</title>
  <link rel="icon" href="/img/eaj-fav.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #2B86C5 100%);
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--primary-gradient);
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      align-items: center;
      color: #2d3436;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    .form-control, .form-select {
      background: rgba(255, 255, 255, 0.5);
      border: 2px solid transparent;
      border-radius: 12px;
      padding: 12px 15px;
      transition: all 0.3s ease;
    }
    .form-control:focus {
      background: #fff;
      border-color: #784BA0;
      box-shadow: 0 0 15px rgba(120, 75, 160, 0.2);
    }
    label {
      font-weight: 600;
      font-size: 0.9rem;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #636e72;
    }
    .btn-apply {
      background: #2d3436;
      color: white;
      border: none;
      border-radius: 12px;
      padding: 15px;
      font-weight: 800;
      letter-spacing: 1px;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-apply:hover {
      transform: translateY(-5px);
      background: #000;
      box-shadow: 0 10px 20px rgba(0,0,0,0.2);
      color: #fff;
    }
    .badge-vibes {
      background: #784BA0;
      color: white;
      padding: 5px 15px;
      border-radius: 50px;
      font-size: 0.7rem;
    }
  </style>
</head>
<body>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-10">
      <div class="glass-card">
        <img src="/img/eaj.png" class="img-fluid" width="150">
        <div class="text-center mb-5">
          <span class="badge-vibes mb-2">WE ARE HIRING</span>
          <h1 class="fw-800" style="font-weight: 800; font-size: 2.5rem;">Drop Your CV.</h1>
          <p class="text-muted">Siap buat level up bareng kita? Isi datanya di bawah ya!</p>
        </div>

        <form action="/apply" method="POST" class="row g-4">
          <div class="col-md-12">
            <label>Full Name</label>
            <input type="text" name="name" value="<%= old.name || '' %>" class="form-control" placeholder="Siapa nama kamu?">
          </div>

          <div class="col-md-6">
            <label>Age</label>
            <input type="number" name="age" value="<%= old.age || '' %>" class="form-control" placeholder="Umur kamu">
          </div>

          <div class="col-md-6">
            <label>NIK</label>
            <input type="text" name="nik" value="<%= old.nik || '' %>" class="form-control" placeholder="Nomor KTP">
          </div>

          <div class="col-md-6">
            <label>Email Address</label>
            <input type="email" name="email" value="<%= old.email || '' %>" class="form-control" placeholder="email@keren.com">
          </div>

          <div class="col-md-6">
            <label>WhatsApp</label>
            <input type="tel" name="whatsapp" value="<%= old.whatsapp || '' %>" class="form-control" placeholder="62812xxxx">
          </div>

          <div class="col-md-12">
            <label>Apply for Role</label>
            <select name="role" class="form-select">
              <option value="" disabled selected>Pilih role yang cocok...</option>
              <option value="Frontend Developer">Frontend Developer</option>
              <option value="UI/UX Designer">UI/UX Designer</option>
              <option value="Social Media Specialist">Social Media Specialist</option>
              <option value="Backend Ninja">Backend Ninja</option>
            </select>
          </div>

          <div class="col-md-12">
            <label>Resume / Portfolio Link</label>
            <input type="url" name="resume" value="<%= old.resume || '' %>" class="form-control" placeholder="https://drive.google.com/...">
          </div>

          <div class="col-12 mt-5">
            <button type="submit" class="btn btn-apply w-100">SEND APPLICATION 🚀</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<% if (status === 'success') { %>
  <script>
    Swal.fire({
      title: 'Terimakasih!',
      text: 'Lamaran kamu udah masuk ke system. Ditunggu info selanjutnya melalui whatsapp kamu.',
      icon: 'success',
      confirmButtonColor: '#784BA0',
      borderRadius: '20px'
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = '/';
      }
    });
  </script>
<% } %>

<% if (status === 'validation-error') { %>
  <script>
    Swal.fire({
      title: 'Validasi Gagal!',
      html: `<ul style="text-align: left;">
              <% errors.forEach(function(error) { %>
                <li><%= error.msg %></li>
              <% }); %>
            </ul>`,
      icon: 'error',
      confirmButtonColor: '#2d3436'
    });
  </script>
<% } %>

<% if (status === 'error') { %>
  <script>
    Swal.fire({
      title: 'System Error!',
      text: 'Maaf, terjadi kesalahan pada server. Coba lagi nanti.',
      icon: 'warning',
      confirmButtonColor: '#2d3436'
    });
  </script>
<% } %>

</body>
</html>